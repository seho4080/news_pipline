# Kafka 설정
KAFKA_BOOTSTRAP=kafka:9092
IN_TOPIC=news-topic
DLQ_TOPIC=news-dlq
GROUP_ID=python-news-group

# PostgreSQL 설정
DB_HOST=postgres
DB_NAME=news_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_MIN_CONN=1
DB_MAX_CONN=5
DB_TIMEOUT=10
DB_IDLE_TIMEOUT=600

# Elasticsearch 설정
ES_BASE_URL=http://elasticsearch:9200
ES_INDEX=news
ES_TIMEOUT=10

# 로깅 설정
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# pgvector 사용 여부 (OpenAI 임베딩 저장용)
USE_PGVECTOR=false
